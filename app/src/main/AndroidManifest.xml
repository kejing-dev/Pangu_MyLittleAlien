<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".platform.SpatialApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_spatial_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_spatial_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpatialApp"
        tools:targetApi="31">

        <activity
            android:name=".platform.LaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.SpatialApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Default Stage: Full Space, Mixed style (real room visible, virtual content always rendered) -->
            <meta-data
                android:name="pico.spatial.stage.id"
                android:value="PanguStage" />
            <!-- "0" Automatic, "1" Mixed, "2" Progressive, "3" Full -->
            <meta-data
                android:name="pico.spatial.stage.style"
                android:value="1" />

        </activity>

        <meta-data
            android:name="icon.3d.list"
            android:resource="@array/icon_3d_list" />
        <meta-data
            android:name="icon.sdf.list"
            android:resource="@array/icon_sdf_list" />
    </application>

</manifest>
